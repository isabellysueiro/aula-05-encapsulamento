{
  "compilerOptions": {
    "module": "NodeNext",
    "target": "ESNext",
    "types": ["node"],
    "sourceMap": false,
    "declaration": false,
    "strict": true,
    "noEmit": true,
    "verbatimModuleSyntax": false,
    "isolatedModules": true,
    "moduleDetection": "force",
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  }
}